RewriteEngine On

Options -Indexes

# Never serve runtime storage (backups, imports, temp, updates) directly over HTTP
RewriteRule ^pp-media/storage(/|$) - [F,L]

RewriteCond %{THE_REQUEST} \s/+(.+?\.php)[\s?] [NC]
RewriteCond %1 !^index\.php$
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


RewriteRule ^(.+)$ index.php?page=$1 [QSA,L]
