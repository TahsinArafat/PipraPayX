# Copy these into a real .env (or let docker compose use the defaults below)

# --- Database ---
DB_NAME=piprapay
DB_USER=piprapay
DB_PASSWORD=piprapay
MYSQL_ROOT_PASSWORD=root

# --- Application ---
DB_PREFIX=pp_
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Leave empty to auto-generate; the generated password is printed in the app container logs
ADMIN_PASSWORD=

# --- Host port for the web UI (http://localhost:<APP_PORT>) ---
APP_PORT=8080
